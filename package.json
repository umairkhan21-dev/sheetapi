{
  "name": "sheet-best-clone",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "postinstall": "prisma generate --config prisma7.config.ts",
    "dev": "next dev",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "build": "prisma generate --config prisma7.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/api-config.test.ts lib/api-key.test.ts lib/connected-account-test-lock.test.ts lib/google-worksheets.records.test.ts lib/jwt-secret.test.ts lib/prisma-deploy.test.ts lib/production-config.test.ts lib/public-api-cors.test.ts lib/public-pages.test.ts lib/public-api-filter.test.ts lib/public-api-pagination.test.ts lib/public-api-write.test.ts lib/rate-limit-ip.test.ts lib/secure-cookies.test.ts lib/token-crypto.test.ts",
    "test:all": "tsx --test lib/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "mariadb": "^3.5.4",
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
